<workspaceElements><cpnet><globbox><ml id="ID101">val P_HIGH = 100;</ml><ml id="ID102">val P_NORMAL = 1000;</ml><ml id="ID103">val P_LOW = 10000;</ml><color id="ID104"><id>QTY</id><int><with><ml>0</ml><ml>20</ml></with></int></color><color id="ID105"><id>KIND</id><enum><id>rush</id><id>normal</id></enum></color><color id="ID106"><id>ORDER</id><product><id>KIND</id><id>QTY</id></product></color><color id="ID107"><id>INT</id><int /></color><var id="ID108"><type><id>KIND</id></type><id>k</id></var><var id="ID109"><type><id>QTY</id></type><id>q</id></var><var id="ID110"><type><id>INT</id></type><id>total</id><id>fee</id></var></globbox><page id="ID1"><pageattr name="Top" /><place id="ID1000"><text>Orders</text><type><text>ORDER</text></type><initmark><text>1`(rush, 3) ++ 1`(normal, 5) ++ 1`(normal, 12)</text></initmark></place><place id="ID1001"><text>Priced</text><type><text>INT</text></type></place><place id="ID1002"><text>Big Orders</text><type><text>ORDER</text></type></place><place id="ID1003"><text>Invoices</text><type><text>INT</text></type></place><trans id="ID2000"><text>Rush</text><cond><text>[k = rush, total = q * 2]</text></cond><priority><text>P_HIGH</text></priority></trans><trans id="ID2001"><text>Normal</text><cond><text>[k = normal, total = q]</text></cond><priority><text>P_LOW</text></priority></trans><trans id="ID2002"><text>Invoice</text><cond><text /></cond><code><text>input (total); output (fee); action (total + 1);</text></code></trans><arc id="ID3000" orientation="PtoT"><transend idref="ID2000" /><placeend idref="ID1000" /><annot><text>(k, q)</text></annot></arc><arc id="ID3001" orientation="TtoP"><transend idref="ID2000" /><placeend idref="ID1001" /><annot><text>total</text></annot></arc><arc id="ID3002" orientation="TtoP"><transend idref="ID2000" /><placeend idref="ID1002" /><annot><text>if q &gt; 10 then 1`(k, q) else empty</text></annot></arc><arc id="ID3003" orientation="PtoT"><transend idref="ID2001" /><placeend idref="ID1000" /><annot><tex