<workspaceElements><cpnet><globbox><ml id="ID101">val N = 5;</ml><color id="ID102"><id>PH</id><index><ml>1</ml><ml>N</ml><id>ph</id></index></color><color id="ID103"><id>CS</id><index><ml>1</ml><ml>N</ml><id>cs</id></index></color><var id="ID104"><type><id>PH</id></type><id>p</id></var><ml id="ID105">fun Left(ph(i)) = cs(i);</ml><ml id="ID106">fun Right(ph(i)) = cs(if i = N then 1 else i + 1);</ml><ml id="ID107">fun Chopsticks(p) = 1`Left(p) ++ 1`Right(p);</ml></globbox><page id="ID1"><pageattr name="Top" /><place id="ID1000"><text>Think</text><type><text>PH</text></type><initmark><text>PH.all()</text></initmark></place><place id="ID1001"><text>Eat</text><type><text>PH</text></type></place><place id="ID1002"><text>Unused Chopsticks</text><type><text>CS</text></type><initmark><text>CS.all()</text></initmark></place><trans id="ID2000"><text>Take Chopsticks</text><cond><text /></cond></trans><trans id="ID2001"><text>Put Down Chopsticks</text><cond><text /></cond></trans><arc id="ID3000" orientation="PtoT"><transend idref="ID2000" /><placeend idref="ID1000" /><annot><text>p</text></annot></arc><arc id="ID3001" orientation="PtoT"><transend idref="ID2000" /><placeend idref="ID1002" /><annot><text>Chopsticks(p)</text></annot></arc><arc id="ID3002" orientation="TtoP"><transend idref="ID2000" /><placeend idref="ID1001" /><annot><text>p</text></annot></arc><arc id="ID3003" orientation="PtoT"><transend idref="ID2001" /><placeend idref="ID1001" /><annot><text>p</text></annot></arc><arc id="ID3004" orientation="TtoP"><transend idref="ID2001" /><placeend idref="ID1002" /><annot><text>Chopsticks(p)</text></annot></arc><arc id="ID3005" orientation="TtoP"><transend idref="ID2001" /><placeend idref="ID1000" /><annot><text>p</text></annot></arc></page><instances><instance id="ID2" page="ID1" /></instances></cpnet></workspaceElements>