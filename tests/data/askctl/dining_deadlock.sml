fun AllDone n = Mark.Top'Eat 1 n = empty andalso Mark.Top'Has_Left 1 n <> empty;
fun Busy n = Mark.Top'Eat 1 n <> empty;
fun Never n = NoOfNodes () < 0;
fun IsDead n = OutArcs n = [];
fun Fin a = case ArcToTI a of TI.Top'Put_Down 1 => true | _ => false;
fun AnyStart a = case ArcToBE a of Bind.Top'Take_Left (1, {p}) => true | _ => false;
fun ManyBusy n = SearchAllNodes (Busy, fn _ => 1, 0, op +) > 1;
val D1 = eval_node (EV (NF ("done", AllDone))) InitNode;
val D2 = eval_node (EV (NF ("busy", Busy))) InitNode;
val D3 = eval_node (ALONG (NOT (NF ("busy", Busy)))) InitNode;
val D4 = eval_node (ALONG TT) InitNode;
val D5 = eval_node (ALONG (NF ("all", fn _ => true))) InitNode;
val D6 = eval_node (POS (ALONG (NF ("done", AllDone)))) InitNode;
val D7 = eval_node (POS (OR (ALONG (NF ("done", AllDone)), NF ("never", Never)))) InitNode;
val D8 = eval_node (EV (INV (NF ("done", AllDone)))) InitNode;
val D9 = eval_node (EV (OR (INV (NF ("done", AllDone)), NF ("never", Never)))) InitNode;
val D10 = eval_node (INV (OR (NF ("dead", IsDead), MODAL (AF ("fin", Fin))))) InitNode;
val D11 = eval_node (POS (NOT (MODAL TT))) InitNode;
val D12 = eval_node (FORALL_NEXT (NF ("busy", Busy))) InitNode;
val D13 = eval_node (EXIST_UNTIL (NOT (NF ("done", AllDone)), NF ("dead", IsDead))) InitNode;
val D14 = eval_node (FORALL_UNTIL (NF ("busy", Busy), NF ("done", AllDone))) InitNode;
val D15 = eval_node (EXIST_MODAL (AF ("start", AnyStart), EXIST_NEXT (NF ("busy", Busy)))) InitNode;
val D16 = eval_node (FORALL_MODAL (AF ("start", AnyStart), NF ("busy", Busy))) InitNode;
val D17 = eval_node (NF ("many", ManyBusy)) InitNode;
val D18 = eval_node (INV (MODAL (FORALL_UNTIL (AF ("start", AnyStart), AF ("fin", Fin))))) InitNode;
val D19 = eval_node (POS (MODAL (ALONG (AF ("start", AnyStart))))) InitNode;
val D20 = eval_node (NF ("live", fn _ => length (ListLiveTIs ()) = 0 andalso length (ListDeadMarkings ()) >= 1)) InitNode;
