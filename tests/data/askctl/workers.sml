fun AllDone n = Mark.Top'Idle 1 n = empty andalso Mark.Top'Busy 1 n = empty;
fun Busy n = Mark.Top'Busy 1 n <> empty;
fun Never n = NoOfNodes () < 0;
fun IsDead n = OutArcs n = [];
fun Fin a = case ArcToTI a of TI.Top'Finish 1 => true | _ => false;
fun AnyStart a = case ArcToBE a of Bind.Top'Start (1, {x}) => true | _ => false;
fun ManyBusy n = SearchAllNodes (Busy, fn _ => 1, 0, op +) > 1;
val W1 = eval_node (EV (NF ("done", AllDone))) InitNode;
val W2 = eval_node (EV (NF ("busy", Busy))) InitNode;
val W3 = eval_node (ALONG (NOT (NF ("busy", Busy)))) InitNode;
val W4 = eval_node (ALONG TT) InitNode;
val W5 = eval_node (ALONG (NF ("all", fn _ => true))) InitNode;
val W6 = eval_node (POS (ALONG (NF ("done", AllDone)))) InitNode;
val W7 = eval_node (POS (OR (ALONG (NF ("done", AllDone)), NF ("never", Never)))) InitNode;
val W8 = eval_node (EV (INV (NF ("done", AllDone)))) InitNode;
val W9 = eval_node (EV (OR (INV (NF ("done", AllDone)), NF ("never", Never)))) InitNode;
val W10 = eval_node (INV (OR (NF ("dead", IsDead), MODAL (AF ("fin", Fin))))) InitNode;
val W11 = eval_node (POS (NOT (MODAL TT))) InitNode;
val W12 = eval_node (FORALL_NEXT (NF ("busy", Busy))) InitNode;
val W13 = eval_node (EXIST_UNTIL (NOT (NF ("done", AllDone)), NF ("dead", IsDead))) InitNode;
val W14 = eval_node (FORALL_UNTIL (NF ("busy", Busy), NF ("done", AllDone))) InitNode;
val W15 = eval_node (EXIST_MODAL (AF ("start", AnyStart), EXIST_NEXT (NF ("busy", Busy)))) InitNode;
val W16 = eval_node (FORALL_MODAL (AF ("start", AnyStart), NF ("busy", Busy))) InitNode;
val W17 = eval_node (NF ("many", ManyBusy)) InitNode;
val W18 = eval_node (INV (MODAL (FORALL_UNTIL (AF ("start", AnyStart), AF ("fin", Fin))))) InitNode;
val W19 = eval_node (POS (MODAL (ALONG (AF ("start", AnyStart))))) InitNode;
val W20 = eval_node (NF ("live", fn _ => length (ListLiveTIs ()) = 0 andalso length (ListDeadMarkings ()) = 1)) InitNode;
